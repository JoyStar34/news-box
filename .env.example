# Local development example only. Use your own PostgreSQL database and credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_box?schema=public"

# AI is optional. Leave all three empty for local fallback text and heuristic ranking.
# To enable AI, set an API key and a model ID supported by your provider.
# An empty base URL uses the OpenAI SDK default; OpenRouter uses https://openrouter.ai/api/v1.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Jobs remain locked while this is empty. Do not use the database password here.
CRON_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Off by default. Enable debug only temporarily and never expose the bearer secret.
ENABLE_PIPELINE_DEBUG="false"

# Optional third-party analytics. Enabling sends visitor data to Plausible.
NEXT_PUBLIC_ENABLE_PLAUSIBLE="false"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
